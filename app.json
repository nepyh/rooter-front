{
  "expo": {
    "name": "rooter",
    "slug": "rooter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./src/assets/app.icon",
      "supportsTablet": false,
      "bundleIdentifier": "io.github.nepyh.rooter",
      "infoPlist": {
        "NSBonjourServices": [
          "_expo._tcp",
          "_expo._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "54.180.112.158": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "scheme": "rooter",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 변경하기 위해 사진 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Pretendard-Regular.ttf",
            "./src/assets/fonts/Pretendard-Medium.ttf",
            "./src/assets/fonts/Pretendard-SemiBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image"
    ],
    "backgroundColor": "#33363F",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa2328a7-6753-46ce-b36e-05e9441abd8f"
      }
    }
  }
}
