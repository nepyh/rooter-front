{
  "expo": {
    "name": "rooter",
    "slug": "rooter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.rooter",
      "infoPlist": {
        "NSBonjourServices": [
          "_expo._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.rooter"
    },
    "scheme": "rooter",
    "web": {
      "bundler": "metro"
    },
    "fonts": [
      "./src/assets/fonts/Pretendard-Regular.otf",
      "./src/assets/fonts/Pretendard-Medium.otf",
      "./src/assets/fonts/Pretendard-Bold.otf"
    ],
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 변경하기 위해 사진 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#33363F"
  }
}
